{
  "name": "@aialra/knowledge-forest-framework",
  "version": "0.1.0",
  "private": false,
  "description": "An open framework for generating evidence-backed, auditable learning forests",
  "license": "Apache-2.0",
  "bin": {
    "knowledge-forest": "packages/cli/bin/knowledge-forest.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "demo:generate": "node scripts/generate-technical-demo.mjs",
    "demo:report": "npm run demo:generate && node scripts/build-demo-report.mjs",
    "readme:stats": "node scripts/generate-readme-stats.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:sanitize": "node scripts/audit-sanitization.mjs",
    "test:unit": "node --test tests/core.test.mjs",
    "test:experience": "node scripts/run-experience-cases.mjs",
    "test": "npm run demo:report && npm run readme:stats && npm run test:unit && npm run test:experience && npm run audit:sanitize && npm run build && npm run build:pages && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@xyflow/react": "^12.11.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "minimatch": "10.2.5",
    "postcss": "8.5.21",
    "sharp": "0.35.3"
  },
  "type": "module"
}
