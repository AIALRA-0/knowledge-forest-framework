{
  "name": "@aialra/knowledge-forest-framework",
  "version": "0.1.0",
  "private": false,
  "description": "An open framework for generating evidence-backed, auditable learning forests",
  "license": "Apache-2.0",
  "bin": {
    "knowledge-forest": "packages/cli/bin/knowledge-forest.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "start": "node scripts/run-vinext.mjs start",
    "typecheck": "tsc --noEmit",
    "demo:generate": "node scripts/generate-technical-demo.mjs",
    "demo:report": "npm run demo:generate && node scripts/build-demo-report.mjs",
    "readme:stats": "node scripts/generate-readme-stats.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:sanitize": "node scripts/audit-sanitization.mjs",
    "test:unit": "node --test tests/core.test.mjs tests/graph-model.test.mjs tests/design-tokens.test.mjs tests/ledger.test.mjs",
    "test:experience": "node scripts/run-experience-cases.mjs",
    "test": "npm run demo:report && npm run readme:stats && npm run test:unit && npm run test:experience && npm run audit:sanitize && npm run build && npm run build:pages && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@xyflow/react": "^12.11.6",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.3.0",
    "wrangler": "4.131.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fflate": "0.7.5",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.4"
  },
  "type": "module"
}
